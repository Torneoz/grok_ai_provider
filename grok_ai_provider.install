<?php

/**
 * @file
 * Install and update hooks for the Grok AI Provider module.
 */

declare(strict_types=1);

/**
 * Adds Responses transport and hosted-tool configuration defaults.
 */
function grok_ai_provider_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('grok_ai_provider.settings');
  if ($config->get('transport') === NULL) {
    $config->set('transport', 'auto');
  }
  if ($config->get('store_responses') === NULL) {
    $config->set('store_responses', FALSE);
  }
  if ($config->get('hosted_tools') === NULL) {
    $config->set('hosted_tools', [
      'web_search' => FALSE,
      'x_search' => FALSE,
      'code_interpreter' => FALSE,
      'file_search' => FALSE,
      'mcp' => FALSE,
    ]);
  }
  if ($config->get('mcp_servers') === NULL) {
    $config->set('mcp_servers', []);
  }
  $config->save(TRUE);
}

/**
 * Adds a bounded timeout for synchronous Responses requests.
 */
function grok_ai_provider_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('grok_ai_provider.settings');
  if ($config->get('request_timeout') === NULL) {
    $config->set('request_timeout', 300)->save(TRUE);
  }
}

/**
 * Adds the configurable default Grok model.
 */
function grok_ai_provider_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('grok_ai_provider.settings');
  if ($config->get('default_model') === NULL) {
    $config->set('default_model', 'grok-4.5')->save(TRUE);
  }
}

/**
 * Adds pricing metadata and configurable Explorer prompt defaults.
 */
function grok_ai_provider_update_10004(): void {
  $config = \Drupal::configFactory()->getEditable('grok_ai_provider.settings');
  $defaults = [
    'pricing_json' => '',
    'pricing_source' => 'packaged',
    'pricing_checked_at' => '',
    'pricing_hash' => '',
    'explorer_prompts' => array_map(
      static fn (mixed $prompt): string => (string) $prompt,
      grok_ai_provider_explorer_prompt_defaults(),
    ),
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save(TRUE);
}
