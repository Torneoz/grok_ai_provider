msgid "Grok xAi Provider"
msgstr "موفّر Grok xAi"

msgid "Grok AI Provider"
msgstr "موفّر Grok للذكاء الاصطناعي"

msgid "Provides Grok models from xAI to the Drupal AI modules."
msgstr "يوفّر نماذج Grok من xAI لوحدات الذكاء الاصطناعي في Drupal."

msgid "AI Providers"
msgstr "موفّرو الذكاء الاصطناعي"

msgid "Grok authentication"
msgstr "مصادقة Grok"

msgid "Configure access to the xAI API."
msgstr "تهيئة الوصول إلى واجهة xAI البرمجية."

msgid "Configure Grok authentication, models, transports, and hosted tools."
msgstr "تهيئة مصادقة Grok والنماذج ووسائل النقل والأدوات المستضافة."

msgid "Configure Grok Integrations"
msgstr "تهيئة تكاملات Grok"

msgid "xAI API key"
msgstr "مفتاح واجهة xAI البرمجية"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "اختر مفتاحًا يحتوي على مفتاح واجهة برمجية تم إنشاؤه في وحدة تحكم xAI."

msgid "Advanced settings"
msgstr "الإعدادات المتقدمة"

msgid "API base URL"
msgstr "عنوان URL الأساسي للواجهة البرمجية"

msgid "Transport"
msgstr "وسيلة النقل"

msgid "Automatic (recommended)"
msgstr "تلقائي (موصى به)"

msgid "Chat Completions only"
msgstr "إكمالات المحادثة فقط"

msgid "Responses API for compatible requests"
msgstr "واجهة Responses للطلبات المتوافقة"

msgid "Allow xAI to store Responses API requests"
msgstr "السماح لـ xAI بتخزين طلبات واجهة Responses"

msgid "Responses request timeout"
msgstr "مهلة طلب Responses"

msgid "Test connection"
msgstr "اختبار الاتصال"

msgid "Test connection and load models"
msgstr "اختبار الاتصال وتحميل النماذج"

msgid "Default Grok model"
msgstr "نموذج Grok الافتراضي"

msgid "Hosted tool permissions"
msgstr "أذونات الأدوات المستضافة"

msgid "Permit Web Search"
msgstr "السماح ببحث الويب"

msgid "Permit X Search"
msgstr "السماح بالبحث في X"

msgid "Permit Code Interpreter"
msgstr "السماح بمفسّر الشفرة"

msgid "Permit Collections Search"
msgstr "السماح بالبحث في المجموعات"

msgid "Permit allowlisted remote MCP servers"
msgstr "السماح بخوادم MCP البعيدة المدرجة في القائمة المسموح بها"

msgid "Remote MCP server allowlist"
msgstr "قائمة خوادم MCP البعيدة المسموح بها"

msgid "About"
msgstr "حول"

msgid "Next Steps"
msgstr "الخطوات التالية"

msgid "Version: @version"
msgstr "الإصدار: @version"

msgid "seconds"
msgstr "ثوانٍ"

msgid "The selected Key does not contain an API key."
msgstr "المفتاح المحدد لا يحتوي على مفتاح واجهة برمجية."

msgid "Could not authenticate with xAI: @message"
msgstr "تعذّرت المصادقة مع xAI: @message"

msgid "Connection failed: @message"
msgstr "فشل الاتصال: @message"

msgid "xAI did not return any accessible Grok models for this key."
msgstr "لم تُرجع xAI أي نماذج Grok يمكن الوصول إليها لهذا المفتاح."
