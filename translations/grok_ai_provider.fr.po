msgstr "Clé API xAI"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "Sélectionnez une clé contenant une clé API créée dans la console xAI."

msgid "Advanced settings"
msgstr "Paramètres avancés"

msgid "API base URL"
msgstr "URL de base de l’API"

