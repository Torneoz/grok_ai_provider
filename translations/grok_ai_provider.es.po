msgid "seconds"
msgstr "segundos"

msgid "The selected Key does not contain an API key."
msgstr "La clave seleccionada no contiene una clave de API."

msgid "Could not authenticate with xAI: @message"
msgstr "No se pudo autenticar con xAI: @message"

msgid "Connection failed: @message"
msgstr "Error de conexión: @message"

