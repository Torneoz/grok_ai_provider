msgstr "Usar el medio predeterminado"

msgid "Upload a JPG, JPEG, PNG, or WebP image."
msgstr "Suba una imagen JPG, JPEG, PNG o WebP."

msgid "Default Explorer image"
msgstr "Imagen predeterminada del Explorador"

msgid "Drupal Media image"
msgstr "Imagen de medios de Drupal"

