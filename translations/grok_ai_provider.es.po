msgid "Grok xAi Provider"
msgstr "Proveedor Grok xAi"

msgid "Grok AI Provider"
msgstr "Proveedor de IA Grok"

msgid "Provides Grok models from xAI to the Drupal AI modules."
msgstr "Proporciona modelos Grok de xAI a los módulos de IA de Drupal."

msgid "AI Providers"
msgstr "Proveedores de IA"

msgid "Grok authentication"
msgstr "Autenticación de Grok"

msgid "Configure access to the xAI API."
msgstr "Configurar el acceso a la API de xAI."

msgid "Configure Grok authentication, models, transports, and hosted tools."
msgstr "Configurar la autenticación, los modelos, los transportes y las herramientas alojadas de Grok."

msgid "Configure Grok Integrations"
msgstr "Configurar integraciones de Grok"

msgid "xAI API key"
msgstr "Clave de API de xAI"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "Seleccione una clave que contenga una clave de API creada en la consola de xAI."

msgid "Advanced settings"
msgstr "Configuración avanzada"

msgid "API base URL"
msgstr "URL base de la API"

msgid "Transport"
msgstr "Transporte"

msgid "Automatic (recommended)"
msgstr "Automático (recomendado)"

msgid "Chat Completions only"
msgstr "Solo Chat Completions"

msgid "Responses API for compatible requests"
msgstr "API Responses para solicitudes compatibles"

msgid "Allow xAI to store Responses API requests"
msgstr "Permitir que xAI almacene solicitudes de la API Responses"

msgid "Responses request timeout"
msgstr "Tiempo de espera de solicitudes Responses"

msgid "Test connection"
msgstr "Probar conexión"

msgid "Test connection and load models"
msgstr "Probar conexión y cargar modelos"

msgid "Default Grok model"
msgstr "Modelo Grok predeterminado"

msgid "Hosted tool permissions"
msgstr "Permisos de herramientas alojadas"

msgid "Permit Web Search"
msgstr "Permitir búsqueda web"

msgid "Permit X Search"
msgstr "Permitir búsqueda en X"

msgid "Permit Code Interpreter"
msgstr "Permitir intérprete de código"

msgid "Permit Collections Search"
msgstr "Permitir búsqueda en colecciones"

msgid "Permit allowlisted remote MCP servers"
msgstr "Permitir servidores MCP remotos autorizados"

msgid "Remote MCP server allowlist"
msgstr "Lista de servidores MCP remotos autorizados"

msgid "About"
msgstr "Acerca de"

msgid "Next Steps"
msgstr "Próximos pasos"

msgid "Try the configured models in the <a href=\":chat_url\">Chat Generation Explorer</a> and <a href=\":image_url\">Text-To-Image Generation Explorer</a>."
msgstr "Pruebe los modelos configurados en el <a href=\":chat_url\">Explorador de generación de chat</a> y el <a href=\":image_url\">Explorador de generación de texto a imagen</a>."

msgid "To use Grok in CKEditor, enable the <strong>AI CKEditor integration</strong> module, then open <a href=\":url\">Text formats and editors</a>. Edit each CKEditor 5 text format that needs AI, add the AI button to its active toolbar, enable the required AI actions, and select <strong>Grok (xAI)</strong> with a Grok chat model for each action, or verify that the action uses the site-wide Chat default. Also grant the appropriate roles the <em>use ai ckeditor</em> permission."
msgstr "Para usar Grok en CKEditor, habilite el módulo <strong>Integración de AI con CKEditor</strong> y abra <a href=\":url\">Formatos de texto y editores</a>. Edite cada formato de texto de CKEditor 5 que necesite AI, añada el botón de AI a su barra de herramientas activa, habilite las acciones de AI necesarias y seleccione <strong>Grok (xAI)</strong> con un modelo de chat de Grok para cada acción, o compruebe que la acción utilice el valor predeterminado de Chat del sitio. Conceda también a los roles apropiados el permiso <em>use ai ckeditor</em>."

msgid "Number of images"
msgstr "Número de imágenes"

msgid "Aspect ratio"
msgstr "Relación de aspecto"

msgid "Resolution"
msgstr "Resolución"

msgid "Request transparent background"
msgstr "Solicitar fondo transparente"

msgid "Version: @version"
msgstr "Versión: @version"

msgid "seconds"
msgstr "segundos"

msgid "The selected Key does not contain an API key."
msgstr "La clave seleccionada no contiene una clave de API."

msgid "Could not authenticate with xAI: @message"
msgstr "No se pudo autenticar con xAI: @message"

msgid "Connection failed: @message"
msgstr "Error de conexión: @message"

msgid "xAI did not return any accessible Grok models for this key."
msgstr "xAI no devolvió ningún modelo Grok accesible para esta clave."
