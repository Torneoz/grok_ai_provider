msgid "Grok xAi Provider"
msgstr "Proveedor Grok xAi"

msgid "Grok AI Provider"
msgstr "Proveedor de IA Grok"

msgid "Provides Grok models from xAI to the Drupal AI modules."
msgstr "Proporciona modelos Grok de xAI a los módulos de IA de Drupal."

msgid "AI Providers"
msgstr "Proveedores de IA"

msgid "Grok authentication"
msgstr "Autenticación de Grok"

msgid "Configure access to the xAI API."
msgstr "Configurar el acceso a la API de xAI."

msgid "Configure Grok authentication, models, transports, and hosted tools."
msgstr "Configurar la autenticación, los modelos, los transportes y las herramientas alojadas de Grok."

msgid "Configure Grok Integrations"
msgstr "Configurar integraciones de Grok"

msgid "xAI API key"
msgstr "Clave de API de xAI"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "Seleccione una clave que contenga una clave de API creada en la consola de xAI."

msgid "Advanced settings"
msgstr "Configuración avanzada"

msgid "API base URL"
msgstr "URL base de la API"

msgid "Transport"
msgstr "Transporte"

msgid "Automatic (recommended)"
msgstr "Automático (recomendado)"

msgid "Chat Completions only"
msgstr "Solo Chat Completions"

