msgid "Grok xAi Provider"
msgstr "Grok-xAi-Anbieter"

msgid "Grok AI Provider"
msgstr "Grok-KI-Anbieter"

msgid "Provides Grok models from xAI to the Drupal AI modules."
msgstr "Stellt Grok-Modelle von xAI für die KI-Module von Drupal bereit."

msgid "AI Providers"
msgstr "KI-Anbieter"

msgid "Grok authentication"
msgstr "Grok-Authentifizierung"

msgid "Configure access to the xAI API."
msgstr "Zugriff auf die xAI-API konfigurieren."

msgid "Configure Grok authentication, models, transports, and hosted tools."
msgstr "Grok-Authentifizierung, Modelle, Übertragungsarten und gehostete Werkzeuge konfigurieren."

msgid "Configure Grok Integrations"
msgstr "Grok-Integrationen konfigurieren"

msgid "xAI API key"
msgstr "xAI-API-Schlüssel"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "Wählen Sie einen Schlüssel aus, der einen in der xAI-Konsole erstellten API-Schlüssel enthält."

msgid "Advanced settings"
msgstr "Erweiterte Einstellungen"

msgid "API base URL"
msgstr "API-Basis-URL"

msgid "Transport"
msgstr "Übertragungsart"

msgid "Automatic (recommended)"
msgstr "Automatisch (empfohlen)"

msgid "Chat Completions only"
msgstr "Nur Chat Completions"

msgid "Responses API for compatible requests"
msgstr "Responses-API für kompatible Anfragen"

msgid "Allow xAI to store Responses API requests"
msgstr "xAI das Speichern von Responses-API-Anfragen erlauben"

msgid "Responses request timeout"
msgstr "Zeitüberschreitung für Responses-Anfragen"

msgid "Test connection"
msgstr "Verbindung testen"

msgid "Test connection and load models"
msgstr "Verbindung testen und Modelle laden"

msgid "Default Grok model"
msgstr "Standardmäßiges Grok-Modell"

msgid "Hosted tool permissions"
msgstr "Berechtigungen für gehostete Werkzeuge"

msgid "Permit Web Search"
msgstr "Websuche erlauben"

msgid "Permit X Search"
msgstr "X-Suche erlauben"

msgid "Permit Code Interpreter"
msgstr "Code Interpreter erlauben"

msgid "Permit Collections Search"
msgstr "Sammlungssuche erlauben"

msgid "Permit allowlisted remote MCP servers"
msgstr "Zugelassene entfernte MCP-Server erlauben"

msgid "Remote MCP server allowlist"
msgstr "Zulassungsliste entfernter MCP-Server"

msgid "About"
msgstr "Über"

msgid "Next Steps"
msgstr "Nächste Schritte"

msgid "Number of images"
msgstr "Anzahl der Bilder"

msgid "Aspect ratio"
msgstr "Seitenverhältnis"

msgid "Resolution"
msgstr "Auflösung"

msgid "Request transparent background"
msgstr "Transparenten Hintergrund anfordern"

msgid "Version: @version"
msgstr "Version: @version"

msgid "seconds"
msgstr "Sekunden"

msgid "The selected Key does not contain an API key."
msgstr "Der ausgewählte Schlüssel enthält keinen API-Schlüssel."

msgid "Could not authenticate with xAI: @message"
msgstr "Authentifizierung bei xAI nicht möglich: @message"

msgid "Connection failed: @message"
msgstr "Verbindung fehlgeschlagen: @message"

msgid "xAI did not return any accessible Grok models for this key."
msgstr "xAI hat für diesen Schlüssel keine zugänglichen Grok-Modelle zurückgegeben."
