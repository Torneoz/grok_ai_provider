msgid "Version: @version"
msgstr "版本：@version"

msgid "seconds"
msgstr "秒"

msgid "The selected Key does not contain an API key."
msgstr "所选密钥不包含 API 密钥。"

msgid "Could not authenticate with xAI: @message"
msgstr "无法通过 xAI 进行身份验证：@message"

msgid "Connection failed: @message"
msgstr "连接失败：@message"

msgid "xAI did not return any accessible Grok models for this key."
msgstr "xAI 未返回此密钥可访问的任何 Grok 模型。"
