msgid "Grok xAi Provider"
msgstr "Fornecedor Grok xAi"

msgid "Grok AI Provider"
msgstr "Fornecedor de IA Grok"

msgid "Provides Grok models from xAI to the Drupal AI modules."
msgstr "Fornece modelos Grok da xAI aos módulos de IA do Drupal."

msgid "AI Providers"
msgstr "Fornecedores de IA"

msgid "Grok authentication"
msgstr "Autenticação Grok"

msgid "Configure access to the xAI API."
msgstr "Configurar o acesso à API da xAI."

msgid "Configure Grok authentication, models, transports, and hosted tools."
msgstr "Configurar autenticação, modelos, transportes e ferramentas hospedadas do Grok."

msgid "Configure Grok Integrations"
msgstr "Configurar integrações do Grok"

msgid "xAI API key"
msgstr "Chave da API xAI"

msgid "Select a Key containing an API key created in the xAI Console."
msgstr "Selecione uma chave que contenha uma chave de API criada no console da xAI."

msgid "Advanced settings"
msgstr "Definições avançadas"

msgid "API base URL"
msgstr "URL base da API"

msgid "Transport"
msgstr "Transporte"

msgid "Automatic (recommended)"
msgstr "Automático (recomendado)"

msgid "Chat Completions only"
msgstr "Apenas Chat Completions"

msgid "Responses API for compatible requests"
msgstr "API Responses para pedidos compatíveis"

msgid "Allow xAI to store Responses API requests"
msgstr "Permitir que a xAI armazene pedidos da API Responses"

msgid "Responses request timeout"
msgstr "Tempo limite do pedido Responses"

msgid "Test connection"
msgstr "Testar ligação"

msgid "Test connection and load models"
msgstr "Testar ligação e carregar modelos"

msgid "Default Grok model"
msgstr "Modelo Grok predefinido"

msgid "Hosted tool permissions"
msgstr "Permissões de ferramentas hospedadas"

msgid "Permit Web Search"
msgstr "Permitir pesquisa na Web"

msgid "Permit X Search"
msgstr "Permitir pesquisa no X"

msgid "Permit Code Interpreter"
msgstr "Permitir interpretador de código"

msgid "Permit Collections Search"
msgstr "Permitir pesquisa em coleções"

msgid "Permit allowlisted remote MCP servers"
msgstr "Permitir servidores MCP remotos autorizados"

msgid "Remote MCP server allowlist"
msgstr "Lista de servidores MCP remotos autorizados"

msgid "About"
msgstr "Sobre"

msgid "Next Steps"
msgstr "Próximos passos"

msgid "Try the configured models in the <a href=\":chat_url\">Chat Generation Explorer</a> and <a href=\":image_url\">Text-To-Image Generation Explorer</a>."
msgstr "Experimente os modelos configurados no <a href=\":chat_url\">Explorador de geração de conversas</a> e no <a href=\":image_url\">Explorador de geração de texto para imagem</a>."

msgid "To use Grok in CKEditor, enable the <strong>AI CKEditor integration</strong> module, then open <a href=\":url\">Text formats and editors</a>. Edit each CKEditor 5 text format that needs AI, add the AI button to its active toolbar, enable the required AI actions, and select <strong>Grok (xAI)</strong> with a Grok chat model for each action, or verify that the action uses the site-wide Chat default. Also grant the appropriate roles the <em>use ai ckeditor</em> permission."
msgstr "Para usar o Grok no CKEditor, ative o módulo <strong>Integração do AI com o CKEditor</strong> e abra <a href=\":url\">Formatos de texto e editores</a>. Edite cada formato de texto do CKEditor 5 que precise de AI, adicione o botão de AI à barra de ferramentas ativa, ative as ações de AI necessárias e selecione <strong>Grok (xAI)</strong> com um modelo de chat Grok para cada ação, ou confirme que a ação usa a predefinição de Chat do site. Conceda também às funções apropriadas a permissão <em>use ai ckeditor</em>."

msgid "Number of images"
msgstr "Número de imagens"

msgid "Aspect ratio"
msgstr "Proporção"

msgid "Resolution"
msgstr "Resolução"

msgid "Request transparent background"
msgstr "Solicitar fundo transparente"

msgid "Version: @version"
msgstr "Versão: @version"

msgid "seconds"
msgstr "segundos"

msgid "The selected Key does not contain an API key."
msgstr "A chave selecionada não contém uma chave de API."

msgid "Could not authenticate with xAI: @message"
msgstr "Não foi possível autenticar na xAI: @message"

msgid "Connection failed: @message"
msgstr "Falha na ligação: @message"

msgid "xAI did not return any accessible Grok models for this key."
msgstr "A xAI não devolveu modelos Grok acessíveis para esta chave."
