<?php

/**
 * @file
 * Hooks for the Grok Documents submodule.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function grok_doc_help(string $route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.grok_doc') {
    return '<p>' . t('Grok Documents manages bulk ingestion into existing xAI Collections. It is an alpha feature: test with a temporary collection before using production documents.') . '</p>';
  }
  return NULL;
}
